# Ambientes e segredos
.venv/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
.pytest_cache/
*.bak

# Dados privados: somente marcadores vazios entram no Git
/data/*
!/data/raw/
!/data/processed/
!/data/curated/
!/data/quality/
/data/raw/**
/data/processed/**
/data/curated/**
/data/quality/**
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/curated/.gitkeep
!data/quality/.gitkeep

# Relatórios, exportações e arquivos locais podem conter dados pessoais.
/reports/
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*:Zone.Identifier
*.log
*.wav
*.flac
*.mp3
*.m4a
*.ogg
*.oga
*.opus
*.aac
*.mp4
*.webm
*.parquet
*.csv
*.sql.gz
*.dump
*.pem
*.key
.aws/
.codex/
.agents/
.idea/
.vscode/
.DS_Store
Thumbs.db
