# Copie para .env e substitua pelas credenciais do seu MinIO local.
# Nunca envie este arquivo com credenciais reais ao Git.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=COLOQUE_USUARIO
MINIO_SECRET_KEY=COLOQUE_SENHA
MINIO_SECURE=false
MINIO_BUCKET=discord-voice-analytics

# PostgreSQL: crie um banco separado para este projeto.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=discord_voice_analytics
PGUSER=postgres
PGPASSWORD=COLOQUE_SENHA_POSTGRES
